HOST=0.0.0.0
PORT=8080
ONEBOT_ACCESS_TOKEN=change-me

# 监听的群号，多个用英文逗号分隔
ALLOWED_GROUPS=123456789

# 转发目标 QQ，多个用英文逗号分隔
TARGET_QQS=987654321

# 可管理关键词的 QQ，留空时默认等于 TARGET_QQS
ADMIN_QQS=987654321

# 初始关键词，仅迁移旧配置时使用
KEYWORDS=告警,故障,上线
KEYWORDS_FILE=keywords.json
RULES_FILE=rules.json

# 是否大小写敏感，仅对英文关键词有意义
CASE_SENSITIVE=false

# 是否启用正则匹配
USE_REGEX=false
