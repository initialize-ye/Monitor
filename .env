HOST=0.0.0.0
PORT=18080
ONEBOT_ACCESS_TOKEN=monitor-qq-bot-2026

# 监听的群号，多个用英文逗号分隔
ALLOWED_GROUPS=554817535

# 转发目标 QQ，多个用英文逗号分隔
TARGET_QQS=2731811629

# 可管理关键词的 QQ，留空时默认等于 TARGET_QQS
ADMIN_QQS=2731811629

# 初始关键词，仅迁移旧配置时使用
KEYWORDS=裤子
KEYWORDS_FILE=keywords.json
RULES_FILE=rules.json

# 是否大小写敏感，仅对英文关键词有意义
CASE_SENSITIVE=false

# 是否启用正则匹配
USE_REGEX=false
